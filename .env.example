# NarrativeFlow configuration. Copy to `.env` and fill in.

# 🤖 AI API — Anthropic. Without this, the pipeline falls back to deterministic
# heuristics (rules-based filter, TF-IDF tagging, template synthesis) so the
# system stays runnable end-to-end. With it, the four AI touchpoints below
# light up. See README §"AI API Usage".
ANTHROPIC_API_KEY=

# Model selection. Sonnet handles classify/tag (cheap, fast); Opus handles
# synthesis + lifecycle judgment (deep reasoning).
NARRATIVEFLOW_MODEL_FAST=claude-sonnet-4-6
NARRATIVEFLOW_MODEL_DEEP=claude-opus-4-7

# Storage. Defaults to local SQLite. Switch to Postgres for production:
#   postgresql+psycopg://user:pass@host:5432/narrativeflow
NARRATIVEFLOW_DATABASE_URL=sqlite:///data/narrativeflow.db

# HTTP server.
NARRATIVEFLOW_HOST=127.0.0.1
NARRATIVEFLOW_PORT=8000

# Optional Telegram notifier. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging.
LOG_LEVEL=INFO
